{
  "name": "@te-river/opencode-gov-mode",
  "version": "0.1.4",
  "description": "Hierarchical multi-agent plugin for OpenCode Desktop — imperial government structure with Emperor, Prime Minister, Six Ministries, and deep subagent nesting.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --import tsx --test tests/*.test.ts",
    "prepublishOnly": "tsc",
    "dev": "tsc --watch"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "gov-mode",
    "hierarchical",
    "multi-agent",
    "desktop",
    "ai-coding"
  ],
  "author": "Te-River",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Te-River/Opencode-GovMode.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0"
  }
}
